# 複製為 deploy/.env 後修改；.env 不納入版本控制
# 修改帳號或密碼時，要同步更新根目錄 .env 的 DATABASE_URL

POSTGRES_USER=hammer
POSTGRES_PASSWORD=change_me_dev_password
# 開發用資料庫；測試用資料庫 hammer_erp_test 由 initdb/01-create-test-db.sql 建立
POSTGRES_DB=hammer_erp

# 以下只用於單機部署（docker compose --profile full），皆可省略
# API Server 對外的位址與埠號；預設只綁定本機
# HAMMER_PUBLISH_ADDR=127.0.0.1:8080
# HAMMER_LOG_LEVEL=info
