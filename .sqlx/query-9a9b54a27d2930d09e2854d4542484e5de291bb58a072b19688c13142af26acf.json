  "db_name": "PostgreSQL",
  "query": "\n        SELECT id, entity_id, record_no, data, created_at, created_by, updated_at, updated_by,\n               version\n        FROM custom_records\n        WHERE entity_id = $1 AND deleted_at IS NULL AND ($2::uuid IS NULL OR id < $2)\n        ORDER BY id DESC\n        LIMIT $3\n        ",
