{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            r.id,\n            r.code,\n            r.name,\n            COALESCE(\n                array_agg(rp.permission ORDER BY rp.permission)\n                    FILTER (WHERE rp.permission IS NOT NULL),\n                '{}'\n            ) AS \"permissions!\"\n        FROM roles r\n        LEFT JOIN role_permissions rp ON rp.role_id = r.id\n        GROUP BY r.id\n        ORDER BY r.id\n        ",
