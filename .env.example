# 複製為 .env 後修改；.env 不納入版本控制
# 帳號密碼要與 deploy/.env 一致

# sqlx 與 API Server 使用的資料庫連線
DATABASE_URL=postgres://hammer:change_me_dev_password@127.0.0.1:5432/hammer_erp

# API Server 設定（皆可省略，預設值見 crates/server/src/config.rs）
# HAMMER_LISTEN_ADDR=127.0.0.1:8080
# HAMMER_LOG_LEVEL=info
# HAMMER_LOG_FORMAT=pretty
# HAMMER_ATTACHMENTS_DIR=data/attachments
# HAMMER_BODY_LIMIT_BYTES=10485760
# HAMMER_CONFIG=crates/server/config.example.toml

# 測試用資料庫。執行 cargo test 時用它覆蓋 DATABASE_URL，見 README「整合測試」
# TEST_DATABASE_URL=postgres://hammer:change_me_dev_password@127.0.0.1:5432/hammer_erp_test
